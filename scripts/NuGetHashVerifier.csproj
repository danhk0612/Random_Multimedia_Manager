<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputPath>../artifacts/nuget-hash-bin/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="NuGetHashVerifier.cs" />
    <Reference Include="NuGet.Packaging"><HintPath>$(MSBuildSDKsPath)/../NuGet.Packaging.dll</HintPath></Reference>
    <Reference Include="NuGet.Common"><HintPath>$(MSBuildSDKsPath)/../NuGet.Common.dll</HintPath></Reference>
    <Reference Include="NuGet.Frameworks"><HintPath>$(MSBuildSDKsPath)/../NuGet.Frameworks.dll</HintPath></Reference>
    <Reference Include="NuGet.Versioning"><HintPath>$(MSBuildSDKsPath)/../NuGet.Versioning.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(MSBuildSDKsPath)/../Newtonsoft.Json.dll</HintPath></Reference>
    <Reference Include="System.Security.Cryptography.Pkcs"><HintPath>$(MSBuildSDKsPath)/../System.Security.Cryptography.Pkcs.dll</HintPath></Reference>
  </ItemGroup>
</Project>
