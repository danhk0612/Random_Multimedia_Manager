<UserControl x:Class="RandomMultimediaManager.App.Views.CategoryEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <Button DockPanel.Dock="Bottom" Margin="0,12,0,0" Height="32" Content="새 분류" Click="NewCategory_Click" />
            <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" />
        </DockPanel>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <GroupBox Header="분류 설정">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock VerticalAlignment="Center" Text="이름" />
                    <TextBox Grid.Column="1" Margin="0,0,0,8" Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="타입" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                              ItemsSource="{Binding MediaTypes}" SelectedItem="{Binding CategoryMediaType}" />
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="활성" />
                    <CheckBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" IsChecked="{Binding CategoryIsEnabled}" />
                    <Button Grid.Row="3" Grid.Column="1" Width="100" HorizontalAlignment="Right" Content="분류 저장" Click="SaveCategory_Click" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="소스 폴더">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="150" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" DisplayMemberPath="RootPath" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock VerticalAlignment="Center" Text="경로" />
                        <TextBox Grid.Column="1" Margin="0,0,0,8" ToolTip="로컬·매핑 드라이브 또는 \\서버\공유\폴더 경로"
                                 Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="하위 폴더 포함" />
                        <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" IsChecked="{Binding SourceIncludeSubdirectories}" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="활성" />
                        <CheckBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" IsChecked="{Binding SourceIsEnabled}" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Width="90" Margin="0,0,8,0" Content="새 소스" Click="NewSource_Click" />
                            <Button Width="90" Margin="0,0,8,0" Content="저장" Click="SaveSource_Click" />
                            <Button Width="90" Content="제거" Click="RemoveSource_Click" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Width="100" Content="수동 스캔" Click="ScanCategory_Click" />
                        <Button Grid.Column="1" Width="80" Margin="8,0,12,0" Content="취소"
                                IsEnabled="{Binding IsScanning}" Click="CancelScan_Click" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding ScanProgressMessage}" TextWrapping="Wrap" />
                    </Grid>

                    <GroupBox Grid.Row="4" Margin="0,10,0,0" Header="소스 연결 및 갱신">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="연결 대상" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedSourceBindingMessage}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Text="접근 상태" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedSourceAccessMessage}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="앱 시작 시 검사" />
                            <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding SourceScanOnStartup}" />
                            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="실행 중 갱신" />
                            <WrapPanel Grid.Row="3" Grid.Column="1">
                                <ComboBox Width="140" Margin="0,0,8,0" ItemsSource="{Binding RefreshModes}"
                                          SelectedItem="{Binding SelectedSourceRefreshMode}" />
                                <TextBlock VerticalAlignment="Center" Text="주기 (시간)" />
                                <ComboBox Width="76" Margin="8,0,0,0" ItemsSource="{Binding RefreshIntervalHours}"
                                          SelectedItem="{Binding SourceIntervalHours}"
                                          IsEnabled="{Binding CanEditSourceInterval}" />
                            </WrapPanel>
                            <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Width="130" Margin="0,0,8,0" Content="현재 연결 대상 확인"
                                        Click="ConfirmBinding_Click" IsEnabled="{Binding IsSelectedSource}" />
                                <Button Width="130" Content="갱신 정책 저장" Click="SavePolicy_Click"
                                        IsEnabled="{Binding IsSelectedSource}" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </GroupBox>

            <TextBlock Grid.Row="3" Margin="0,12,0,0" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </Grid>
    </Grid>
</UserControl>
