<Window x:Class="RandomMultimediaManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RandomMultimediaManager.App.Views"
        Title="Random Multimedia Manager" Width="960" Height="640">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,6">
            <Button Content="만화 뷰어" Padding="12,6" Margin="0,0,8,0" Click="OpenComicViewer" />
            <Button Content="영상 기반 검증" Padding="12,6" Click="OpenVideoValidation" />
        </StackPanel>
        <views:CategoryEditorView />
    </DockPanel>
</Window>
