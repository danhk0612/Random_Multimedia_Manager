<Window x:Class="RandomMultimediaManager.App.Video.VideoValidationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="T09/T10 영상·자막 검증" Width="1180" Height="760" MinWidth="820" MinHeight="500"
        Closing="OnClosing" PreviewKeyDown="OnKeyDown">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top">
            <WrapPanel>
                <Button x:Name="PrepareButton" Content="파일 준비" Click="PrepareFile" Padding="10,5" />
                <Button x:Name="ActivateButton" Content="준비 대상 활성화" Click="ActivatePrepared" IsEnabled="False" Margin="6,0" />
                <Button Content="준비 취소 / 폐기" Click="CancelPreparation" />
                <Button Content="미디어 모두 해제" Click="ReleaseMedia" Margin="6,0" />
                <Button Content="전체화면" Click="ToggleFullscreen" />
                <CheckBox x:Name="SoftwareOnly" Content="다음 준비: 소프트웨어 디코딩 검증" VerticalAlignment="Center" Margin="10,0" />
                <CheckBox x:Name="RestoreEnd" Content="다음 준비: 끝 위치 복원 검증" VerticalAlignment="Center" Margin="10,0" />
            </WrapPanel>
            <TextBlock x:Name="Status" Text="T10 검증 창 — 영상 준비/활성 후 외부 자막 자동 검색·수동 로드를 확인하세요. DB 기록 없음." Margin="0,7" TextWrapping="Wrap" />
            <TextBlock x:Name="AudioNotice" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
            <WrapPanel x:Name="Controls" IsEnabled="False" Margin="0,7">
                <Button Content="재생" Click="Play" />
                <Button Content="일시정지" Click="Pause" Margin="5,0" />
                <Button Content="정지" Click="Stop" />
                <Button Content="−10초" Click="SeekBack" Margin="5,0" />
                <Button Content="+10초" Click="SeekForward" />
                <TextBlock Text="볼륨" VerticalAlignment="Center" Margin="12,0,4,0" />
                <Slider x:Name="Volume" Minimum="0" Maximum="100" Value="70" Width="100" ValueChanged="VolumeChanged" />
                <CheckBox x:Name="Muted" Content="음소거" Click="MuteChanged" Margin="8,0" VerticalAlignment="Center" />
                <ComboBox x:Name="Rate" Width="72" SelectedIndex="1" SelectionChanged="RateChanged">
                    <ComboBoxItem Content="0.5×" Tag="0.5" />
                    <ComboBoxItem Content="1×" Tag="1" />
                    <ComboBoxItem Content="1.5×" Tag="1.5" />
                    <ComboBoxItem Content="2×" Tag="2" />
                </ComboBox>
                <Button Content="트랙 새로고침" Click="RefreshTracks" Margin="8,0" />
                <ComboBox x:Name="Audio" Width="140" DisplayMemberPath="Name" ToolTip="오디오 트랙" SelectionChanged="AudioChanged" />
                <ComboBox x:Name="Subtitles" Width="140" DisplayMemberPath="Name" ToolTip="현재 LibVLC 자막 트랙" SelectionChanged="SubtitleChanged" Margin="5,0" />
            </WrapPanel>
            <WrapPanel Margin="0,0,0,6">
                <TextBlock Text="외부 자막" VerticalAlignment="Center" Margin="0,0,5,0" />
                <ComboBox x:Name="ExternalSubtitles" Width="250" DisplayMemberPath="DisplayName"
                          ToolTip="자동 검색 후보 선택 또는 자막 끄기" SelectionChanged="ExternalSubtitleChanged" />
                <Button Content="SRT/SMI 수동 열기" Click="LoadExternalSubtitle" Margin="6,0" />
            </WrapPanel>
            <Slider x:Name="Position" Minimum="0" Maximum="1" IsEnabled="False"
                    PreviewMouseLeftButtonDown="BeginSeek" PreviewMouseLeftButtonUp="EndSeek" />
            <TextBlock x:Name="TimeText" Text="00:00:00 / 00:00:00" Margin="0,5" />
            <Expander Header="엔진 진단 (하드웨어 사용 여부는 로그와 GPU로 확인)">
                <TextBox x:Name="Diagnostics" IsReadOnly="True" Height="120" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
            </Expander>
        </StackPanel>
        <Grid x:Name="VideoSurface" Background="Black" />
    </DockPanel>
</Window>
