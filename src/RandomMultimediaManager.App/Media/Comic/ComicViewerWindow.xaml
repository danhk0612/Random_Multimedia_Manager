<Window x:Class="RandomMultimediaManager.App.Media.Comic.ComicViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="만화 뷰어" Width="1180" Height="820" Background="#202020"
        KeyDown="OnKeyDown">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#303030" Padding="8">
            <WrapPanel VerticalAlignment="Center">
                <Button x:Name="OpenButton" Content="열기" Click="OpenFile" Margin="0,0,8,0" Padding="10,4" />
                <Button Content="◀" Click="PreviousPage" Margin="0,0,4,0" Padding="10,4" />
                <Button Content="▶" Click="NextPage" Margin="0,0,12,0" Padding="10,4" />
                <TextBlock x:Name="PageText" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ComboBox x:Name="DisplayModeBox" Width="120" SelectionChanged="DisplayModeChanged" Margin="0,0,8,0">
                    <ComboBoxItem Content="한 페이지" Tag="SinglePage" IsSelected="True" />
                    <ComboBoxItem Content="두 페이지" Tag="TwoPage" />
                    <ComboBoxItem Content="세로 스크롤" Tag="VerticalScroll" />
                </ComboBox>
                <ComboBox x:Name="DirectionBox" Width="110" SelectionChanged="DirectionChanged" Margin="0,0,8,0">
                    <ComboBoxItem Content="왼쪽 → 오른쪽" Tag="LeftToRight" IsSelected="True" />
                    <ComboBoxItem Content="오른쪽 → 왼쪽" Tag="RightToLeft" />
                </ComboBox>
                <ComboBox x:Name="FitModeBox" Width="105" SelectionChanged="FitModeChanged" Margin="0,0,8,0">
                    <ComboBoxItem Content="원본 크기" Tag="Original" />
                    <ComboBoxItem Content="창 맞춤" Tag="FitWindow" IsSelected="True" />
                    <ComboBoxItem Content="폭 맞춤" Tag="FitWidth" />
                    <ComboBoxItem Content="높이 맞춤" Tag="FitHeight" />
                </ComboBox>
                <TextBlock x:Name="ZoomText" Foreground="White" VerticalAlignment="Center" />
            </WrapPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#303030" Padding="8">
            <TextBlock x:Name="StatusText" Foreground="White" Text="ZIP/CBZ를 여세요. Ctrl+휠: 확대, 드래그: 팬" />
        </Border>
        <Grid x:Name="ViewerHost" Background="#161616"
              SizeChanged="ViewerSizeChanged"
              MouseWheel="ViewerMouseWheel"
              MouseLeftButtonDown="ViewerMouseLeftButtonDown"
              MouseLeftButtonUp="ViewerMouseLeftButtonUp"
              MouseMove="ViewerMouseMove">
            <Image x:Name="Canvas" Stretch="Fill" SnapsToDevicePixels="True" />
        </Grid>
    </DockPanel>
</Window>
